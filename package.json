{
  "name": "dsh-command-context",
  "version": "0.1.0",
  "description": "A /context slash command for DeepSeek Harness: shows how much of the current session's context window is used, how much is free, and a per-category breakdown of what fills it.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "slash-command",
    "command",
    "context",
    "context-window",
    "tokens",
    "token-usage",
    "observability"
  ],
  "license": "MIT",
  "author": "Lovenndme",
  "homepage": "https://github.com/Lovenndme/dsh-command-context#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lovenndme/dsh-command-context.git"
  },
  "bugs": {
    "url": "https://github.com/Lovenndme/dsh-command-context/issues"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.5": "verified"
      },
      "note": "Host-only bundle. Uses ctx.commands.register, ctx.sessions.get, ctx.tokenMeter.measure, and Session.requestContext/requestHeader/eventAt. On a host without those services the plugin fails to load instead of printing wrong numbers."
    }
  }
}
